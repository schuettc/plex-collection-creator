# Database location (defaults to ./data/plex-collections.db)
DATABASE_URL=./data/plex-collections.db

# Encryption key for storing sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# --- MCP server (optional) ---------------------------------------------------
# The MCP server (npm run mcp) lets Claude Code drive your Plex library.
# Provide a Plex server URL + token to run it standalone; if omitted, it falls
# back to the connection the web app saved.
PLEX_URL=
PLEX_TOKEN=
# Required only for the tmdb_* accuracy-audit tools. Free key:
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# AI Provider credentials (configure one)
# Anthropic
ANTHROPIC_API_KEY=

# Amazon Bedrock (uses AWS credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Google Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=

# OpenAI
OPENAI_API_KEY=
