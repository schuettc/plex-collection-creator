# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
/data/
*.db

# local development
.mcp.json
.playwright-mcp/

# internal docs (not for public repo)
PRD.md
EPCC_PLAN.md
epcc-features.json
epcc-progress.md

# claude (ignore local settings/plans, but ship the shared skills)
.claude/*
!.claude/skills/
